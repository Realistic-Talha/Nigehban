# =============================================================================
# Nigehban — Environment Variables (Zero-Cost Stack Defaults)
# =============================================================================
# Copy to .env and adjust. NEVER commit .env.

# ---- Database ----------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://nigehban:nigehban@localhost:5432/nigehban

# ---- Redis -------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ---- LLM (default: local Ollama — no API key required) ------------------------
LLM_PROVIDER=groq
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_FAST=qwen2.5:7b-instruct
OLLAMA_MODEL_REASONING=qwen2.5:14b-instruct
# GROQ_API_KEY=
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# mock is banned when ENVIRONMENT=prod

# ---- Fact Check Tools (optional) ---------------------------------------------
# GOOGLE_FACTCHECK_API_KEY=

# ---- Search ------------------------------------------------------------------
SEARCH_PROVIDER=duckduckgo

# ---- Embeddings --------------------------------------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# ---- Object storage (MinIO local dev) ----------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=nigehban-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# ---- WhatsApp (deferred — leave empty) ---------------------------------------
WHATSAPP_TOKEN=
WHATSAPP_VERIFY_TOKEN=nigehban-internal-verify
WHATSAPP_PHONE_NUMBER_ID=

# ---- RSS feeds (optional JSON list in env) -----------------------------------
# RSS_FEED_URLS=["https://www.dawn.com/feeds/home"]

# ---- Public / Client-side ----------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8001

# ---- AIGC / UnivFD (CLIP on Colab — do not download on PC) --------------------
# Start training/colab/13_aigc_remote_server.py on Colab GPU, then paste tunnel URL:
# AIGC_REMOTE_URL=https://xxxx.trycloudflare.com
# AIGC_REMOTE_TIMEOUT=60

# ---- Environment -------------------------------------------------------------
ENVIRONMENT=dev
